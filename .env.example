# .env.example
# Copy this file to .env and fill in the values.
# `next dev`/`next build` only load `.env` / `.env.local`, never `.env.example`.

# ---------------------------------------------------------------------------
# Public client (browser + server components). Safe to expose, RLS enforced.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Server aliases (used by lib/supabase/server.ts). Same public anon key.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Privileged key — SERVER ONLY.
# NEVER prefix this with NEXT_PUBLIC_ and never import lib/supabase/admin.ts
# from a client component. Only used by isolated server-side admin tooling.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

